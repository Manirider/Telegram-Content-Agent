# Telegram Bot Configuration
# Get your token from @BotFather
TELEGRAM_BOT_TOKEN=

# Google Sheets Configuration
# Base64 encoded service account JSON
# Create a service account in Google Cloud Console, enable Sheets API, share spreadsheet with service account email
# Then: cat credentials.json | base64 -w 0
GOOGLE_SHEETS_CREDENTIALS_B64=

# Google Spreadsheet ID (from URL: https://docs.google.com/spreadsheets/d/SPREADSHEET_ID/edit)
GOOGLE_SHEETS_SPREADSHEET_ID=

# Worksheet name (default: Content)
GOOGLE_SHEETS_WORKSHEET=Content

# Ollama Configuration (Local LLM)
# Default assumes Ollama running in docker-compose network
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3.1
OLLAMA_TIMEOUT_SECONDS=120

# Groq Configuration (Cloud LLM Fallback)
# Get API key from https://console.groq.com
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-70b-versatile
GROQ_TIMEOUT_SECONDS=60

# Gemini Configuration (Cloud LLM Fallback)
# Get API key from https://aistudio.google.com
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
GEMINI_TIMEOUT_SECONDS=60

# LLM Provider Routing
# Primary provider: ollama, groq, or gemini
LLM_PRIMARY_PROVIDER=ollama
# Comma-separated fallback providers
LLM_FALLBACK_PROVIDERS=groq,gemini

# Database Configuration
# SQLite database path (persisted via Docker volume)
DATABASE_PATH=/data/style_memory.db

# HTTP Configuration
HTTP_TIMEOUT_SECONDS=30
HTTP_MAX_REDIRECTS=5

# Content Limits
MAX_TEXT_LENGTH=50000
MAX_PDF_SIZE_MB=50
MAX_URL_CONTENT_LENGTH=100000

# Retry Configuration
MAX_RETRIES=3
RETRY_BASE_DELAY=1.0
RETRY_MAX_DELAY=60.0
RETRY_JITTER=0.1

# Logging
LOG_LEVEL=INFO

# Health Check
HEALTH_HOST=0.0.0.0
HEALTH_PORT=8080

# Style Memory
MAX_STYLE_LENGTH=2000